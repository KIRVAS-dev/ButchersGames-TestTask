# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# By default unity supports Blender asset imports, *.blend1 blender files do not need to be committed to version control.
*.blend1
*.blend1.meta

.utmp/
/Template-UnityProject/[Ll]ibrary/
/Template-UnityProject/ios/
/Template-UnityProject/[Tt]emp/
/Template-UnityProject/[Oo]bj/
/Template-UnityProject/[Bb]uild/
/Template-UnityProject/[Bb]uilds/
/Template-UnityProject/[Ll]ogs/
/Template-UnityProject/[Uu]ser[Ss]ettings/
/Template-UnityProject/[Rr]ecordings
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/Template-UnityProject/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/Template-UnityProject/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/Template-UnityProject/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
/Template-UnityProject/.vs/
/Template-UnityProject/.idea
/Template-UnityProject/.git

# Gradle cache directory
/Template-UnityProject/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/Template-UnityProject/ExportedObj/
/Template-UnityProject/.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
/Template-UnityProject/[Aa]ssets/[Ss]treaming[Aa]ssets/build_inf*

# Crashlytics generated file
/Template-UnityProject/crashlytics-build.properties

# Packed Addressables
/Template-UnityProject/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/Template-UnityProject/[Aa]ssets/[Ss]treamingAssets/aa.meta
/Template-UnityProject/[Aa]ssets/[Ss]treamingAssets/aa/*

# Exceptions
!*.dll
!*.obj

# MaсOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# CI
CI/Temp/
CI/Base/__pycache__/
Template-UnityProject/Assets/SceneDependencyCache

# VSCode
.vscode/
Template-UnityProject/Template-UnityProject.slnx

#NuGetForUnity
Template-UnityProject/[Pp]ackages/nuget-packages/InstalledPackages*

#Build cache
Template-UnityProject/.utmp

# FMOD
# Never ignore DLLs in the FMOD subfolder.
!Template-UnityProject/[Aa]ssets/Plugins/FMOD/**/lib/*

# Don't ignore images and gizmos used by FMOD in the Unity Editor.
!Template-UnityProject/[Aa]ssets/Gizmos/FMOD/*
!Template-UnityProject/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache folder since it is updated locally.
Template-UnityProject/[Aa]ssets/Plugins/FMOD/Cache/*

# Ignore bank files in the StreamingAssets folder.
Template-UnityProject/[Aa]ssets/StreamingAssets/**/*.bank
Template-UnityProject/[Aa]ssets/StreamingAssets/**/*.bank.meta

# If the source bank files are kept outside of the StreamingAssets folder then these can be ignored.
# Log files can be ignored.
Template-UnityProject/fmod_editor.log

FMOD/.*
