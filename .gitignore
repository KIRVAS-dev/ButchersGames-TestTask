# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# By default unity supports Blender asset imports, *.blend1 blender files do not need to be committed to version control.
*.blend1
*.blend1.meta

.utmp/
/ButchersGames/[Ll]ibrary/
/ButchersGames/ios/
/ButchersGames/[Tt]emp/
/ButchersGames/[Oo]bj/
/ButchersGames/[Bb]uild/
/ButchersGames/[Bb]uilds/
/ButchersGames/[Ll]ogs/
/ButchersGames/[Uu]ser[Ss]ettings/
/ButchersGames/[Rr]ecordings
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/ButchersGames/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/ButchersGames/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/ButchersGames/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
/ButchersGames/.vs/
/ButchersGames/.idea
/ButchersGames/.git

# Gradle cache directory
/ButchersGames/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/ButchersGames/ExportedObj/
/ButchersGames/.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
/ButchersGames/[Aa]ssets/[Ss]treaming[Aa]ssets/build_inf*

# Crashlytics generated file
/ButchersGames/crashlytics-build.properties

# Packed Addressables
/ButchersGames/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/ButchersGames/[Aa]ssets/[Ss]treamingAssets/aa.meta
/ButchersGames/[Aa]ssets/[Ss]treamingAssets/aa/*

# Exceptions
!*.dll
!*.obj

# MaсOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# CI
CI/Temp/
CI/Base/__pycache__/
ButchersGames/Assets/SceneDependencyCache

# VSCode
.vscode/
ButchersGames/ButchersGames.slnx

#NuGetForUnity
ButchersGames/[Pp]ackages/nuget-packages/InstalledPackages*

#Build cache
ButchersGames/.utmp

# FMOD
# Never ignore DLLs in the FMOD subfolder.
!ButchersGames/[Aa]ssets/Plugins/FMOD/**/lib/*

# Don't ignore images and gizmos used by FMOD in the Unity Editor.
!ButchersGames/[Aa]ssets/Gizmos/FMOD/*
!ButchersGames/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache folder since it is updated locally.
ButchersGames/[Aa]ssets/Plugins/FMOD/Cache/*

# Ignore bank files in the StreamingAssets folder.
ButchersGames/[Aa]ssets/StreamingAssets/**/*.bank
ButchersGames/[Aa]ssets/StreamingAssets/**/*.bank.meta

# If the source bank files are kept outside of the StreamingAssets folder then these can be ignored.
# Log files can be ignored.
ButchersGames/fmod_editor.log

FMOD/.*
